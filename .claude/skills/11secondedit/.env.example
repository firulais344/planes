# Copy to .env in your project root (already git-ignored) and fill in what you have.
# Missing keys never break the edit: enhance audio falls back to local FFmpeg, music is skipped.

# Audio enhancement — https://auphonic.com/accounts/settings/#api-key
AUPHONIC_API_KEY=

# Background music — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# WhisperX (local transcription)
# WHISPERX_PYTHON=/path/to/venv/bin/python   # a Python that has `whisperx` installed (default: python3)
# WHISPERX_MODEL=small                       # tiny | base | small | medium | large-v3
# WHISPERX_DEVICE=cpu                        # cpu | cuda (auto-detected)

# Server
# ELEVENSE_PORT=4111
# ELEVENSE_WORKDIR=.11secondedit
