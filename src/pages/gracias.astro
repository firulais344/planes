---
import Base from "../layouts/Base.astro";
---

<Base titulo="¡Gracias! · Parchemos" descripcion="Recibimos tu mensaje.">
  <div class="mx-auto w-[min(34rem,100%-2rem)] py-20 text-center">
    <h1 class="font-display text-4xl font-extrabold tracking-tight">¡Gracias!</h1>
    <p class="mt-4 text-lg text-suave">Recibimos tu mensaje y lo revisaremos pronto.</p>
    <a class="btn btn--primario mt-8" href="/">Volver a los planes</a>
  </div>
</Base>
