---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Explorador from "../components/Explorador.tsx";
import { aPublico } from "../lib/publico";
import { hoyBogota } from "../lib/fechas";
import { construirPresets, enlacesRelacionados } from "../lib/presets";

export async function getStaticPaths() {
  const planes = (await getCollection("planes")).map((e) => aPublico(e.data));
  return construirPresets(planes).map((preset) => ({ params: { filtro: preset.slug }, props: { preset } }));
}

const { preset } = Astro.props;
const planes = (await getCollection("planes")).map((e) => aPublico(e.data));
const otras = enlacesRelacionados(construirPresets(planes), preset.slug);
---

<Base titulo={preset.metaTitulo} descripcion={preset.descripcion}>
  <section class="mx-auto w-[min(1120px,100%-2rem)] pb-8 pt-12 md:pt-14">
    <p class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-cian"><a href="/" class="hover:underline">Parchemos</a> · Medellín</p>
    <h1 class="font-display text-[clamp(2rem,6vw,3.6rem)] font-extrabold leading-[1.02] tracking-tight">{preset.titulo}</h1>
    <p class="mt-4 max-w-2xl text-lg text-suave">{preset.intro}</p>
  </section>

  <Explorador client:load planes={planes} hoyInicial={hoyBogota()} preset={preset.estado} />

  <nav aria-label="Otras búsquedas" class="mx-auto mt-4 w-[min(1120px,100%-2rem)]">
    <h2 class="mb-3 font-display text-xl font-extrabold">Otras formas de buscar</h2>
    <ul class="flex flex-wrap gap-2">
      {
        otras.map((o) => (
          <li>
            <a class="chip" href={`/${o.slug}/`}>{o.titulo.replace(/ en Medellín$/, "").replace(/^Qué hacer en /, "")}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>
