---
import Base from "../layouts/Base.astro";
import Explorador from "../components/Explorador.tsx";
import { cargarPlanes } from "../lib/planes";
import Boletin from "../components/Boletin.astro";
import { hoyBogota } from "../lib/fechas";
import { jsonldSitio } from "../lib/jsonld";
import { SITIO } from "../config/sitio";

const planes = await cargarPlanes();
const hoy = hoyBogota();
---

<Base jsonld={[jsonldSitio(new URL("/", Astro.site).href, SITIO.nombre)]}>
  <section class="mx-auto w-[min(1120px,100%-2rem)] pb-8 pt-12 md:pt-16">
    <p class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-cian">Planes en Medellín</p>
    <h1 class="font-display text-[clamp(2.4rem,8vw,4.8rem)] font-extrabold leading-[0.98] tracking-tight">
      ¿Qué hacemos <span class="bg-gradient-to-r from-acento to-[#ffb83d] bg-clip-text text-transparent">hoy</span>?
    </h1>
    <p class="mt-4 max-w-xl text-lg text-suave">
      Fiestas, conciertos, parques, comida y cultura. Elige el día, el presupuesto y con quién vas, y te mostramos qué hay.
    </p>
  </section>

  <Explorador client:load planes={planes} hoyInicial={hoy} />
  <Boletin />
</Base>
