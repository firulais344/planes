---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { Arte, horarioVisible } from "../../components/PlanCard.tsx";
import BotonFavorito from "../../components/BotonFavorito.tsx";
import AvisoPasado from "../../components/AvisoPasado.tsx";
import Mapa from "../../components/Mapa.tsx";
import PlanCard from "../../components/PlanCard.tsx";
import { aPublico, type PlanPublico } from "../../lib/publico";
import { CATEGORIA_NOMBRE } from "../../lib/schema";
import { diaCorto, diaLargo, hoyBogota, yaPaso } from "../../lib/fechas";
import { precioInfo } from "../../lib/precio";
import { esAgendable } from "../../lib/ics";

export async function getStaticPaths() {
  const todos = (await getCollection("planes")).map((e) => aPublico(e.data));
  return todos.map((plan) => ({ params: { slug: plan.slug }, props: { plan, todos } }));
}

const { plan, todos } = Astro.props as { plan: PlanPublico; todos: PlanPublico[] };
const hoy = hoyBogota();
const precio = precioInfo(plan);
const horario = horarioVisible(plan);
const agendable = esAgendable(plan);

const DIAS: Record<string, string> = { lun: "lunes", mar: "martes", mie: "miércoles", jue: "jueves", vie: "viernes", sab: "sábados", dom: "domingos" };
let cuando = "Siempre disponible";
if (plan.inicio) {
  if (plan.recurrencia) {
    const dias = plan.recurrencia.dias.map((d) => DIAS[d]).join(" y ");
    cuando = `Los ${dias}, del ${diaCorto(plan.inicio)} al ${diaCorto(plan.recurrencia.hasta ?? plan.fin ?? plan.inicio)}`;
  } else if (plan.fin && plan.fin !== plan.inicio) cuando = `Del ${diaCorto(plan.inicio)} al ${diaCorto(plan.fin)}`;
  else cuando = diaLargo(plan.inicio);
}

const PENDIENTE_TXT: Record<string, string> = { horario: "horario", precio: "precio", direccion: "dirección", fecha: "fecha" };
const pendientes = plan.pendientes.filter((c) => c in PENDIENTE_TXT).map((c) => PENDIENTE_TXT[c]);
const IDEAL: Record<string, string> = { pareja: "en pareja", amigos: "con amigos", familia: "en familia", solo: "solo/a" };

// Relacionados: misma categoría, zona y etiquetas; sin eventos pasados.
const relacionados = todos
  .filter((p) => p.slug !== plan.slug && !(p.tipo === "evento" && yaPaso(p, hoy)))
  .map((p) => ({ p, puntos: (p.categoria === plan.categoria ? 2 : 0) + (p.zona.nombre === plan.zona.nombre ? 1 : 0) + p.etiquetas.filter((t) => plan.etiquetas.includes(t)).length }))
  .filter((x) => x.puntos > 0)
  .sort((a, b) => b.puntos - a.puntos || a.p.titulo.localeCompare(b.p.titulo, "es"))
  .slice(0, 3)
  .map((x) => x.p);

const alternativas = todos.filter((p) => p.slug !== plan.slug && p.tipo === "evento" && p.categoria === plan.categoria && !yaPaso(p, hoy)).slice(0, 4);

const canonica = new URL(`/planes/${plan.slug}/`, Astro.site).href;
const comoLlegar = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${plan.lugar}, Medellín`)}`;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${plan.titulo} en Medellín: ${canonica}`)}`;
const conMapa = plan.lat !== undefined && plan.lng !== undefined;
const filaDt = "text-sm font-bold uppercase tracking-wide text-suave";
---

<Base titulo={`${plan.titulo} · Parchemos`} descripcion={plan.descripcionCorta}>
  <article class="mx-auto w-[min(60rem,100%-2rem)] py-8">
    <p class="mb-4"><a href="/" class="font-semibold text-suave hover:text-texto hover:underline">← Todos los planes</a></p>

    <div class="overflow-hidden rounded-tarjeta border border-linea">
      <Arte categoria={plan.categoria} alto={150} />
    </div>

    <header class="mt-6">
      <p class="text-sm font-bold uppercase tracking-[0.12em] text-cian">{CATEGORIA_NOMBRE[plan.categoria]}</p>
      <h1 class="mt-1 font-display text-[clamp(2rem,5vw,3.2rem)] font-extrabold leading-[1.05] tracking-tight">{plan.titulo}</h1>
      <p class="mt-3 max-w-2xl text-lg">{plan.descripcionCorta}</p>
      {plan.descripcionLarga && <p class="mt-3 max-w-2xl text-suave">{plan.descripcionLarga}</p>}
    </header>

    <div class="mt-6">
      <AvisoPasado client:load plan={{ tipo: plan.tipo, inicio: plan.inicio, fin: plan.fin, recurrencia: plan.recurrencia }} alternativas={alternativas} hoyInicial={hoy} />
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn--primario" href={plan.fuente.url} target="_blank" rel="noopener noreferrer">
        {plan.tipo === "evento" ? "Ver entradas e información" : "Ver más información"} ↗<span class="solo-lectores"> en {plan.fuente.nombre} (se abre en otra pestaña)</span>
      </a>
      <a class="btn" href={comoLlegar} target="_blank" rel="noopener noreferrer">Cómo llegar ↗<span class="solo-lectores"> (se abre en otra pestaña)</span></a>
      {agendable && <a class="btn" href={`/planes/${plan.slug}.ics`} download>Agregar al calendario</a>}
      <a class="btn" href={whatsapp} data-wa target="_blank" rel="noopener noreferrer">Compartir por WhatsApp<span class="solo-lectores"> (se abre en otra pestaña)</span></a>
      <BotonFavorito client:load slug={plan.slug} titulo={plan.titulo} conTexto />
    </div>

    <dl class="mt-8 grid gap-6 rounded-tarjeta border border-linea bg-superficie p-6 sm:grid-cols-2">
      <div>
        <dt class={filaDt}>Cuándo</dt>
        <dd class="mt-1 text-lg">{cuando}{horario ? ` · ${horario}` : ""}</dd>
      </div>
      <div>
        <dt class={filaDt}>Dónde</dt>
        <dd class="mt-1 text-lg">
          {plan.lugar}
          {plan.direccion && <span class="block text-suave">{plan.direccion}</span>}
          <span class="block text-suave">{plan.zona.nombre}{plan.zona.comuna ? ` · Comuna ${plan.zona.comuna}` : ""}</span>
        </dd>
      </div>
      <div>
        <dt class={filaDt}>Precio</dt>
        <dd class="mt-1 text-lg">
          {precio.texto}
          {plan.precio.nota && !plan.pendientes.includes("precio") && <span class="block text-base text-suave">{plan.precio.nota}</span>}
        </dd>
      </div>
      <div>
        <dt class={filaDt}>Ideal para</dt>
        <dd class="mt-1 text-lg">{plan.idealPara.map((c) => IDEAL[c]).join(", ")}{plan.edadMinima ? ` · Desde ${plan.edadMinima} años` : ""}</dd>
      </div>
    </dl>

    {
      pendientes.length > 0 && (
        <p class="mt-4 rounded-xl border border-linea bg-superficie px-4 py-3 text-sm text-suave">
          Aún no confirmamos {pendientes.join(", ")}. Revísalo en <a class="font-bold text-acento underline underline-offset-4" href={plan.fuente.url} target="_blank" rel="noopener noreferrer">{plan.fuente.nombre}</a> antes de salir.
        </p>
      )
    }

    {
      conMapa && (
        <section class="mt-10" aria-labelledby="mapa-titulo">
          <h2 id="mapa-titulo" class="mb-3 font-display text-2xl font-extrabold">Ubicación</h2>
          <Mapa client:visible detalle alto="340px" etiqueta={`Mapa de ${plan.lugar}`} puntos={[{ slug: plan.slug, titulo: plan.lugar, lat: plan.lat!, lng: plan.lng!, categoria: plan.categoria }]} />
          <p class="mt-2 text-sm text-suave">Ubicación aproximada según OpenStreetMap. Confirma la dirección exacta en la fuente.</p>
        </section>
      )
    }

    {
      relacionados.length > 0 && (
        <section class="mt-12" aria-labelledby="rel-titulo">
          <h2 id="rel-titulo" class="mb-4 font-display text-2xl font-extrabold">Planes parecidos</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relacionados.map((p) => <PlanCard client:visible plan={p} hoy={hoy} />)}
          </div>
        </section>
      )
    }
  </article>

  <script>
    // La URL real del sitio puede diferir de la de construcción: el enlace de WhatsApp usa la actual.
    document.querySelectorAll<HTMLAnchorElement>("[data-wa]").forEach((a) => {
      const titulo = document.querySelector("h1")?.textContent ?? "";
      a.href = `https://wa.me/?text=${encodeURIComponent(`${titulo} en Medellín: ${location.href.split("#")[0]}`)}`;
    });
  </script>
</Base>
