---
import Base from "../layouts/Base.astro";
---

<Base titulo="Página no encontrada · Parchemos" descripcion="Esta página no existe.">
  <div class="mx-auto w-[min(34rem,100%-2rem)] py-20 text-center">
    <p class="font-display text-7xl font-extrabold text-acento">404</p>
    <h1 class="mt-2 font-display text-3xl font-extrabold tracking-tight">Aquí no hay parche</h1>
    <p class="mt-4 text-lg text-suave">La página que buscas no existe o cambió de lugar. Mira lo que sí hay en Medellín.</p>
    <a class="btn btn--primario mt-8" href="/">Ver planes</a>
  </div>
</Base>
