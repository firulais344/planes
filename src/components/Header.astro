---
import Logo from "./Logo.astro";

const actual = Astro.url.pathname;
const enlaces = [
  { href: "/", texto: "Planes" },
  { href: "/publica-tu-plan/", texto: "Publica tu plan" },
  { href: "/acerca-de/", texto: "Acerca de" },
  { href: "/contacto/", texto: "Contacto" },
];
const esActual = (href: string) => (href === "/" ? actual === "/" : actual.startsWith(href));
---

<header class="sticky top-0 z-30 border-b border-linea bg-fondo/85 backdrop-blur">
  <div class="mx-auto flex h-16 w-[min(1120px,100%-2rem)] items-center justify-between gap-3">
    <a href="/" aria-label="Parchemos, ir al inicio" class="rounded-lg"><Logo id="hdr" /></a>

    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            aria-current={esActual(e.href) ? "page" : undefined}
            class="rounded-lg px-3 py-2 text-[0.95rem] font-semibold text-suave hover:text-texto aria-[current=page]:text-texto aria-[current=page]:underline aria-[current=page]:decoration-acento aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
          >
            {e.texto}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" id="tema" class="btn !min-h-11 !w-11 !p-0" aria-label="Cambiar entre modo oscuro y claro" aria-pressed="false">
        <svg class="tema-luna" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="tema-sol hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button type="button" id="menu-btn" class="btn !min-h-11 !w-11 !p-0 md:hidden" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>

  <nav id="menu-movil" aria-label="Principal (móvil)" class="hidden border-t border-linea bg-fondo md:hidden">
    <ul class="mx-auto flex w-[min(1120px,100%-2rem)] flex-col py-2">
      {
        enlaces.map((e) => (
          <li>
            <a href={e.href} aria-current={esActual(e.href) ? "page" : undefined} class="block rounded-lg px-2 py-3 font-semibold text-suave hover:text-texto aria-[current=page]:text-texto">
              {e.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const raiz = document.documentElement;
  const btnTema = document.getElementById("tema") as HTMLButtonElement;
  const luna = btnTema.querySelector(".tema-luna")!;
  const sol = btnTema.querySelector(".tema-sol")!;

  function pintar() {
    const claro = raiz.dataset.theme === "light";
    btnTema.setAttribute("aria-pressed", String(claro));
    luna.classList.toggle("hidden", claro);
    sol.classList.toggle("hidden", !claro);
  }
  btnTema.addEventListener("click", () => {
    const siguiente = raiz.dataset.theme === "light" ? "dark" : "light";
    raiz.dataset.theme = siguiente;
    try { localStorage.setItem("tema", siguiente); } catch {}
    pintar();
  });
  pintar();

  const btnMenu = document.getElementById("menu-btn") as HTMLButtonElement;
  const menu = document.getElementById("menu-movil")!;
  btnMenu.addEventListener("click", () => {
    const abierto = menu.classList.toggle("hidden") === false;
    btnMenu.setAttribute("aria-expanded", String(abierto));
    btnMenu.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && btnMenu.getAttribute("aria-expanded") === "true") btnMenu.click();
  });
</script>
