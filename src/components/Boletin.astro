---
import { boletinActivo } from "../config/sitio";
import Consentimiento from "./Consentimiento.astro";

const activo = boletinActivo();
---

{
  activo && (
    <section aria-labelledby="boletin-titulo" class="mx-auto mt-16 w-[min(1120px,100%-2rem)] rounded-tarjeta border border-linea bg-superficie p-6 md:p-10">
      <div class="grid gap-8 md:grid-cols-2 md:items-center">
        <div>
          <h2 id="boletin-titulo" class="font-display text-3xl font-extrabold tracking-tight">Los mejores planes del finde, cada jueves</h2>
          <p class="mt-3 text-suave">Estamos preparando el boletín. Déjanos tu correo y te avisamos cuando empiece a salir. Puedes darte de baja cuando quieras.</p>
        </div>
        <form name="boletin" method="POST" action="/gracias/" data-netlify="true" netlify-honeypot="bot-field" class="grid gap-4">
          <input type="hidden" name="form-name" value="boletin" />
          <p class="hidden"><label>No llenes esto: <input name="bot-field" /></label></p>
          <div>
            <label for="bol-correo" class="mb-1 block font-semibold">Correo</label>
            <input class="campo" id="bol-correo" name="correo" type="email" required maxlength="120" autocomplete="email" />
          </div>
          <div>
            <label for="bol-wa" class="mb-1 block font-semibold">WhatsApp <span class="font-normal text-suave">(opcional)</span></label>
            <input class="campo" id="bol-wa" name="whatsapp" type="tel" inputmode="tel" maxlength="20" autocomplete="tel" placeholder="+57 300 000 0000" />
          </div>
          <Consentimiento id="bol-consentimiento" />
          <button class="btn btn--primario justify-self-start" type="submit" data-umami-event="boletin_envio">Quiero enterarme</button>
        </form>
      </div>
    </section>
  )
}
